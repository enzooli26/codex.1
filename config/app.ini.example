[server]
host=127.0.0.1
port=9527

[tls]
certificate=server-cert.pem
private_key=server-key.pem

[database]
path=data/charging.db

[device]
# Course-project shared credential. Change it in app.ini and pass the same
# value to the charger simulator with --token. Do not commit the real token.
token=course-device-token

[map]
provider=tencent
api_key=
geolocation_enabled=true

[reservation]
timeout_minutes=20
