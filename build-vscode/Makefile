qmake: FORCE
	@$(QMAKE) -o Makefile ..\charging-platform.pro -spec win32-g++

qmake_all: sub-server-qmake_all sub-user_client-qmake_all sub-mobile_client-qmake_all sub-admin_client-qmake_all sub-device_simulator-qmake_all FORCE

make_first: sub-server-make_first-ordered sub-user_client-make_first-ordered sub-mobile_client-make_first-ordered sub-admin_client-make_first-ordered sub-device_simulator-make_first-ordered  FORCE
all: sub-server-all-ordered sub-user_client-all-ordered sub-mobile_client-all-ordered sub-admin_client-all-ordered sub-device_simulator-all-ordered  FORCE
clean: sub-server-clean-ordered sub-user_client-clean-ordered sub-mobile_client-clean-ordered sub-admin_client-clean-ordered sub-device_simulator-clean-ordered  FORCE
distclean: sub-server-distclean-ordered sub-user_client-distclean-ordered sub-mobile_client-distclean-ordered sub-admin_client-distclean-ordered sub-device_simulator-distclean-ordered  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-server-install_subtargets-ordered sub-user_client-install_subtargets-ordered sub-mobile_client-install_subtargets-ordered sub-admin_client-install_subtargets-ordered sub-device_simulator-install_subtargets-ordered FORCE
uninstall_subtargets: sub-server-uninstall_subtargets-ordered sub-user_client-uninstall_subtargets-ordered sub-mobile_client-uninstall_subtargets-ordered sub-admin_client-uninstall_subtargets-ordered sub-device_simulator-uninstall_subtargets-ordered FORCE

sub-server-debug_ordered:
	@if not exist server\ mkdir server\ & if not exist server\ exit 1
	cd server\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\charging-platform-v0.6.1-security-auth-ui-final\charging-platform\server\server.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-user_client-debug_ordered: sub-server-debug_ordered 
	@if not exist user_client\ mkdir user_client\ & if not exist user_client\ exit 1
	cd user_client\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\charging-platform-v0.6.1-security-auth-ui-final\charging-platform\user_client\user_client.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-mobile_client-debug_ordered: sub-user_client-debug_ordered 
	@if not exist mobile_client\ mkdir mobile_client\ & if not exist mobile_client\ exit 1
	cd mobile_client\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\charging-platform-v0.6.1-security-auth-ui-final\charging-platform\mobile_client\mobile_client.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-admin_client-debug_ordered: sub-mobile_client-debug_ordered 
	@if not exist admin_client\ mkdir admin_client\ & if not exist admin_client\ exit 1
	cd admin_client\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\charging-platform-v0.6.1-security-auth-ui-final\charging-platform\admin_client\admin_client.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
sub-device_simulator-debug_ordered: sub-admin_client-debug_ordered 
