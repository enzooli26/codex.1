	cd device_simulator\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\charging-platform-v0.6.1-security-auth-ui-final\charging-platform\device_simulator\device_simulator.pro -spec win32-g++ ) && $(MAKE) -f Makefile debug
